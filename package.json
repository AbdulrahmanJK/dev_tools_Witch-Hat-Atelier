  "description": "Witch Hat Atelier Codebase Viewer - Infinite Canvas Architectural Grimoire for React Projects",
  "type": "module",
  "main": "src/server/index.js",
  "bin": {
    "wha-viewer": "./bin/wha-viewer.js"
  },
  "scripts": {
    "dev": "pnpm --filter @wha/web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint packages/",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "start": "node packages/cli/bin/wha-viewer.js",
    "view:upline": "node packages/cli/bin/wha-viewer.js /Users/abdulrahmanabubakirov/Documents/upline_admin-module"
  },
  "keywords": [
    "witch-hat-atelier",
    "react",
    "ast",
    "code-visualization",
    "infinite-canvas",
    "architecture-viewer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
